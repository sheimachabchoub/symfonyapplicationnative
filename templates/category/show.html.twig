{% extends 'base.html.twig' %}

{% block title %}Category{% endblock %}

{% block body %}
    <h1>Category</h1>

    <table class="table table-hover bg-white shadow-sm">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ category.id }}</td>
            </tr>
            <tr>
                <th>Designation</th>
                <td>{{ category.designation }}</td>
            </tr>
            <tr>
                <th>Description</th>
                <td>{{ category.description }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_category_index') }}" class="btn btn-link">Retour à la liste</a>

    {% if is_granted('ROLE_ADMIN') %}<a href="{{ path('app_category_edit', {'id': category.id}) }}" class="btn btn-sm btn-outline-primary">Modifier</a>{% endif %}
    {% if is_granted('ROLE_ADMIN') %}{{ include('category/_delete_form.html.twig') }}{% endif %}
{% endblock %}
