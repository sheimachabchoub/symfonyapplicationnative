<form method="post" action="{{ path('app_emprunt_retour', {id: emprunt.id}) }}" class="d-inline" onsubmit="return confirm('Enregistrer le retour de « {{ emprunt.livre.titre|e('js') }} » ?');">
    <input type="hidden" name="_token" value="{{ csrf_token('retour' ~ emprunt.id) }}">
    <button class="btn {{ petit|default(false) ? 'btn-sm' }} btn-success" title="Enregistrer le retour"><i class="bi bi-box-arrow-in-down-left"></i> Retour</button>
</form>
