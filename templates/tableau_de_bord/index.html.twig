{% extends 'base.html.twig' %}

{% block title %}Tableau de bord{% endblock %}

{% macro tuile(libelle, valeur, icone, couleur, detail = null) %}
    <div class="col">
        <div class="card h-100 shadow-sm border-0 border-start border-4 border-{{ couleur }}">
            <div class="card-body">
                <div class="d-flex justify-content-between">
                    <span class="text-body-secondary small text-uppercase">{{ libelle }}</span>
                    <i class="bi bi-{{ icone }} text-{{ couleur }} fs-4"></i>
                </div>
                <div class="fs-2 fw-semibold">{{ valeur }}</div>
                {% if detail %}<div class="small text-body-secondary">{{ detail }}</div>{% endif %}
            </div>
        </div>
    </div>
{% endmacro %}
{% import _self as ui %}

{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0"><i class="bi bi-speedometer2"></i> Tableau de bord</h1>
    <a href="{{ path('app_emprunt_new') }}" class="btn btn-primary"><i class="bi bi-plus-lg"></i> Nouvel emprunt</a>
</div>

<div class="row row-cols-1 row-cols-sm-2 row-cols-xl-4 g-3 mb-4">
    {{ ui.tuile('Livres', stats.livres, 'book', 'primary', stats.exemplaires ~ ' exemplaires') }}
    {{ ui.tuile('Disponibles', stats.disponibles, 'check2-circle', 'success', 'exemplaires en rayon') }}
    {{ ui.tuile('Emprunts en cours', stats.empruntsEnCours, 'arrow-left-right', 'info', stats.empruntsTotal ~ ' au total') }}
    {{ ui.tuile('En retard', stats.enRetard, 'exclamation-triangle', stats.enRetard > 0 ? 'danger' : 'secondary') }}
    {{ ui.tuile('Adhérents', stats.adherents, 'people', 'secondary') }}
    {{ ui.tuile('Auteurs', stats.auteurs, 'person-lines-fill', 'secondary') }}
</div>

<h2 class="h5 mb-3"><i class="bi bi-exclamation-triangle text-danger"></i> Emprunts en retard</h2>
<div class="table-responsive bg-white rounded shadow-sm">
    <table class="table align-middle mb-0">
        <thead class="table-light">
            <tr><th>Livre</th><th>Adhérent</th><th>Retour prévu</th><th>Retard</th><th></th></tr>
        </thead>
        <tbody>
        {% for emprunt in enRetard %}
            <tr>
                <td>{{ emprunt.livre.titre }}</td>
                <td><a href="{{ path('app_adherent_show', {id: emprunt.adherent.id}) }}">{{ emprunt.adherent.nomComplet }}</a><br><small class="text-body-secondary">{{ emprunt.adherent.email }}</small></td>
                <td>{{ emprunt.dateRetourPrevue|date('d/m/Y') }}</td>
                <td><span class="badge text-bg-danger">{{ emprunt.joursDeRetard(aujourdhui) }} jour{{ emprunt.joursDeRetard(aujourdhui) > 1 ? 's' }}</span></td>
                <td class="text-end">{{ include('emprunt/_retour_form.html.twig', {petit: true}) }}</td>
            </tr>
        {% else %}
            <tr><td colspan="5" class="text-center text-success py-4"><i class="bi bi-emoji-smile"></i> Aucun emprunt en retard.</td></tr>
        {% endfor %}
        </tbody>
    </table>
</div>
{% endblock %}
