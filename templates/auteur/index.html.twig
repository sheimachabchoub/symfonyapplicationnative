{% extends 'base.html.twig' %}

{% block title %}Auteur index{% endblock %}

{% block body %}
    <h1>Auteur index</h1>

    <table class="table table-hover bg-white shadow-sm">
        <thead>
            <tr>
                <th>Id</th>
                <th>Nom</th>
                <th>Prenom</th>
                <th>Biographie</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for auteur in auteurs %}
            <tr>
                <td>{{ auteur.id }}</td>
                <td>{{ auteur.nom }}</td>
                <td>{{ auteur.prenom }}</td>
                <td>{{ auteur.biographie }}</td>
                <td>
                    <a href="{{ path('app_auteur_show', {'id': auteur.id}) }}" class="btn btn-sm btn-outline-secondary">Voir</a>
                    {% if is_granted('ROLE_ADMIN') %}<a href="{{ path('app_auteur_edit', {'id': auteur.id}) }}" class="btn btn-sm btn-outline-primary">Modifier</a>{% endif %}
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="5">Aucun élément</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    {% if is_granted('ROLE_ADMIN') %}<a href="{{ path('app_auteur_new') }}" class="btn btn-primary">Ajouter</a>{% endif %}
{% endblock %}
