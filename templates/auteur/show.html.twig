{% extends 'base.html.twig' %}

{% block title %}Auteur{% endblock %}

{% block body %}
    <h1>Auteur</h1>

    <table class="table table-hover bg-white shadow-sm">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ auteur.id }}</td>
            </tr>
            <tr>
                <th>Nom</th>
                <td>{{ auteur.nom }}</td>
            </tr>
            <tr>
                <th>Prenom</th>
                <td>{{ auteur.prenom }}</td>
            </tr>
            <tr>
                <th>Biographie</th>
                <td>{{ auteur.biographie }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_auteur_index') }}" class="btn btn-link">Retour à la liste</a>

    {% if is_granted('ROLE_ADMIN') %}<a href="{{ path('app_auteur_edit', {'id': auteur.id}) }}" class="btn btn-sm btn-outline-primary">Modifier</a>{% endif %}
    {% if is_granted('ROLE_ADMIN') %}{{ include('auteur/_delete_form.html.twig') }}{% endif %}
{% endblock %}
